# Copy to the project root as .env for local `netlify dev` use.
# Set the same values in Netlify Site configuration > Environment variables for deploys.
OPENAI_API_KEY=replace-with-a-new-secret-key
OPENAI_MODEL=gpt-4o-mini

# Set these for local OCR; the token must match backend/ocr's OCR_SERVICE_TOKEN.
OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_TOKEN=replace-with-a-long-random-token
